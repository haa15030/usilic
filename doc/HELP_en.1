.\" usilic-rc-line MACRO
.\" usilic-rc-line # Keyboard macros.
.\" usilic-rc-line #
.\" usilic-rc-line # Format: M-n  key  K-n ...   (the key runs the K-n functions in order)
.\" usilic-rc-line #
.\" usilic-rc-line # Keys recorded with ^X( ... ^X) are added at the "--" line by ^Xs right
.\" usilic-rc-line # after ^Xe, and saved as M-n under the key (one letter) you are asked for
.\" usilic-rc-line # (effective at once).  WAIT sets the interval between the keys.
.\" usilic-rc-line 	M-1  ;	K-20 K-4 K-28			# ^G^P^M	Open previous
.\" usilic-rc-line 	M-2  :	K-20 K-3 K-28			# ^G^N^M	Open next
.\" usilic-rc-line 	M-3  [	K-35 K-4			# .^P		Select, go up
.\" usilic-rc-line 	M-4  ]	K-35 K-3			# .^N		Select, go down
.\" usilic-rc-line 	M-5  e	K-67				# ^[e		EDIT
.\" usilic-rc-line 	M-6  l	K-86 K-53 "^usilic-1.5b:" K-28	# ^J^Os^Jp^usilic-1.5b:^M
.\" usilic-rc-line 	     	     	  		  	# PART SHELL in INFO by prompts
.\" usilic-rc-line 	--
