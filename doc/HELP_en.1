.\" usilic-rc-line #
.\" usilic-rc-line # K-114 and later had no key assignment before (they were written in the program, 2026-10-23).
.\" usilic-rc-line # K-132..K-138 work only in COPY, K-139..K-155 only while typing in a prompt; there they take
.\" usilic-rc-line # the place of the K-n with the same default key (K-7 for ^F). ^N/^P, ^G, ^M, ^R, ^S, ^@, ^[N
.\" usilic-rc-line # etc. in COPY and prompts share K-3, K-4, K-20, K-28 etc. (changing those changes these too).
.\" usilic-rc-line     K-114 ESC g g # ^[gg  Go to line (same as ^[N)
.\" usilic-rc-line     K-115 C-u     # ^U    Repeat count for the next command
.\" usilic-rc-line     K-116 F-0 z   # ^Xz   Repeat the last command
.\" usilic-rc-line     K-117 F-0 r m # ^Xrm  Set a bookmark
.\" usilic-rc-line     K-118 F-0 r b # ^Xrb  Jump to a bookmark
.\" usilic-rc-line     K-119 F-0 r l # ^Xrl  List bookmarks
.\" usilic-rc-line     K-120 F-0 r SPC # ^Xr␣  Save this place to a register
.\" usilic-rc-line     K-121 F-0 r C-SPC # ^Xr^␣ Save this place to a register (same as ^Xr␣)
.\" usilic-rc-line     K-122 F-0 r j # ^Xrj  Jump to a register
.\" usilic-rc-line     K-123 F-2 C-s # ^O^S  List of matching lines (FGREP)
.\" usilic-rc-line     K-124 F-2 F-1 C-s # ^O^J^SList of matching lines (EGREP)
.\" usilic-rc-line     K-125 %       # %     (ls): select names matching a regular expression
.\" usilic-rc-line     K-126 *       # *     (ls): select files with the same suffix
.\" usilic-rc-line     K-127 C-t n   # ^Tn   Next window
.\" usilic-rc-line     K-128 C-t p   # ^Tp   Previous window
.\" usilic-rc-line     K-129 C-t C-h # ^T^H  HELP window
.\" usilic-rc-line     K-130 C-t C-k # ^T^K  KEY window
.\" usilic-rc-line     K-131 e       # e     Right after ^Xe: repeat the macro (one key)
.\" usilic-rc-line     K-132 C-f     # ^F    COPY: forward one character
.\" usilic-rc-line     K-133 C-b     # ^B    COPY: back one character
.\" usilic-rc-line     K-134 C-a     # ^A    COPY: beginning of line
.\" usilic-rc-line     K-135 C-e     # ^E    COPY: end of line
.\" usilic-rc-line     K-136 F-0 SPC # ^X␣   COPY: rectangle region
.\" usilic-rc-line     K-137 ESC w   # ^[w   COPY: to the clipboard
.\" usilic-rc-line     K-138 ESC t   # ^[t   COPY: to the TOOL prompt
.\" usilic-rc-line     K-139 C-a     # ^A    Input: beginning of line
.\" usilic-rc-line     K-140 C-e     # ^E    Input: end of line
.\" usilic-rc-line     K-141 C-f     # ^F    Input: forward one character
.\" usilic-rc-line     K-142 C-b     # ^B    Input: back one character
.\" usilic-rc-line     K-143 C-d     # ^D    Input: delete the character at the cursor
.\" usilic-rc-line     K-144 C-h     # ^H    Input: delete the previous character (DEL too)
.\" usilic-rc-line     K-145 C-u     # ^U    Input: delete to the beginning
.\" usilic-rc-line     K-146 C-k     # ^K    Input: delete to the end
.\" usilic-rc-line     K-147 C-y     # ^Y    Input: yank the deleted text
.\" usilic-rc-line     K-148 C-_     # ^_    Input: undo
.\" usilic-rc-line     K-149 C-q     # ^Q    Input: insert the next key as is
.\" usilic-rc-line     K-150 C-i     # ^I    Input: complete the path
.\" usilic-rc-line     K-151 C-w     # ^W    Input: previous directory (CP/MV destination)
.\" usilic-rc-line     K-152 ESC f   # ^[f   Input: forward one word
.\" usilic-rc-line     K-153 ESC b   # ^[b   Input: back one word
.\" usilic-rc-line     K-154 ESC d   # ^[d   Input: delete one word
.\" usilic-rc-line     K-155 ESC C-h # ^[^H  Input: delete the previous word (^[DEL too)
