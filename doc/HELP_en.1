.\" usilic-rc-line BUFFER
.\" usilic-rc-line # Format: `size'
.\" usilic-rc-line #
.\" usilic-rc-line # The maximum size read into the buffer (in MB, 1-100; default 64).  A file
.\" usilic-rc-line # larger than this is not read whole when opened with ^M etc.; it is opened
.\" usilic-rc-line # like ^O^M, reading only what is shown.  Lists (ls, DU, LOCATE, archive
.\" usilic-rc-line # contents), files extracted from an archive, MAN and ^[^M (read as is)
.\" usilic-rc-line # stop reading at this size.  Either way "Not enough buffer" is shown
.\" usilic-rc-line # (any key clears it).  Try a value with usilic -b; usilic -B writes it here.
.\" usilic-rc-line
.\" usilic-rc-line 	64
.\" usilic-rc-line
.\" usilic-rc-line CODE
.\" usilic-rc-line # Format: `code0' `code1' ...
.\" usilic-rc-line #
.\" usilic-rc-line # If a file without any of the suffixes above contains a control code
.\" usilic-rc-line # under 0x20 that is not listed here, it is treated as a binary file:
.\" usilic-rc-line # usilic runs file(1) and shows the code and the file type.  (If `code0'
.\" usilic-rc-line # is 0, this check is not done.)
.\" usilic-rc-line #
.\" usilic-rc-line
.\" usilic-rc-line # ^A(TAGS)  ^G(BEL)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
.\" usilic-rc-line    1         7        8   9  10  12  13  14      15      26       27       31
.\" usilic-rc-line
.\" usilic-rc-line LINE
.\" usilic-rc-line # Format: `line'
.\" usilic-rc-line #
.\" usilic-rc-line # The maximum number of lines kept per history kind (FILE, DIR, MAN,
.\" usilic-rc-line # LOCATE, FGREP, EGREP, SHELL commands).  Beyond this, the oldest line is
.\" usilic-rc-line # removed (USILIC keeps three times as many).  0 means unlimited (the
.\" usilic-rc-line # default).  History never gets large enough to matter for memory, but
.\" usilic-rc-line # ~/.usilic/history is rewritten whole each time an entry is added, so set
.\" usilic-rc-line # a limit if saving starts to feel slow.  Try a value with usilic -l;
.\" usilic-rc-line # usilic -L writes it here.
.\" usilic-rc-line
.\" usilic-rc-line 	0
.\" usilic-rc-line
.\" usilic-rc-line WAIT
.\" usilic-rc-line # Format: `wait'
.\" usilic-rc-line #
.\" usilic-rc-line # Macros are executed at intervals of `wait' (in units of 10 msec).  Try a
.\" usilic-rc-line # value with usilic -w; usilic -W writes it here.  Editing this file with
.\" usilic-rc-line # EDIT applies it at once, since usilic reads it again when it is saved (after
.\" usilic-rc-line # editing it with another editor, ^Xs reads it again).
.\" usilic-rc-line
.\" usilic-rc-line 	1
.\" usilic-rc-line
.\" usilic-rc-line COPY
.\" usilic-rc-line # Format: `cp' (option)
.\" usilic-rc-line #
.\" usilic-rc-line # Command of CP.  (default: cp -vR)
.\" usilic-rc-line #
.\" usilic-rc-line # The macOS cp also copies extended attributes and resource forks (Finder tags
.\" usilic-rc-line # and comments, the URL a file was downloaded from, etc.).  Where the
.\" usilic-rc-line # destination cannot hold extended attributes (FAT/exFAT USB drives, some
.\" usilic-rc-line # NAS, etc.), it puts them in a file named "._<name>" next to the copy (as
.\" usilic-rc-line # Finder does; MV across disks does the same).  Seen from Windows or Linux,
.\" usilic-rc-line # these "._" files look like files without content.  Even so, -X (do not copy
.\" usilic-rc-line # extended attributes) is not the default:
.\" usilic-rc-line #  1. Dropped metadata cannot be restored (extra "._" files can be removed
.\" usilic-rc-line #     later, e.g. with dot_clean).
.\" usilic-rc-line #  2. "._" files appear only when copying to a place that cannot hold
.\" usilic-rc-line #     extended attributes (never when copying within APFS on the Mac).
.\" usilic-rc-line # Write cp -vRX if you do not want "._" files.  The Linux (GNU) cp does not
.\" usilic-rc-line # copy extended attributes with -vR anyway.
.\" usilic-rc-line #
.\" usilic-rc-line
.\" usilic-rc-line #	cp -vRi
.\" usilic-rc-line
.\" usilic-rc-line MOVE
.\" usilic-rc-line # Format: `mv' (option)
.\" usilic-rc-line #
.\" usilic-rc-line # Command of MV.  (default: mv -v)
.\" usilic-rc-line #
.\" usilic-rc-line
.\" usilic-rc-line #	mv -vi
.\" usilic-rc-line
.\" usilic-rc-line DELETE
.\" usilic-rc-line # Format: `rm' (option)
.\" usilic-rc-line #
.\" usilic-rc-line # Command of RM.  (default: rm -vr)
.\" usilic-rc-line #
.\" usilic-rc-line
.\" usilic-rc-line #	rm -vri
.\" usilic-rc-line
.\" usilic-rc-line SPEED
.\" usilic-rc-line # Format: `usec1' `usec2' ...  (levels 1-10)
.\" usilic-rc-line #
.\" usilic-rc-line # The speed of each inertial-scroll level: the time waited for each line
.\" usilic-rc-line # (each dot with -g) moved, in usec, from level 1 (slowest) up.  Levels not
.\" usilic-rc-line # given keep their built-in values.  Try values with usilic -s; usilic -S
.\" usilic-rc-line # writes them here.
.\" usilic-rc-line
.\" usilic-rc-line 	90000 20000 10000 5000 3000 2000 1000 500 200 100
.\" usilic-rc-line
.\" usilic-rc-line DRAG
.\" usilic-rc-line # Format: `dot1' `dot2' ...  (levels 1-10)
.\" usilic-rc-line #
.\" usilic-rc-line # When a screen drag is released, the amount of motion (dots) just before
.\" usilic-rc-line # that decides the inertial-scroll level: at least `dot1' for level 1,
.\" usilic-rc-line # `dot2' for level 2, and so on.  Try values with usilic -d; usilic -D
.\" usilic-rc-line # writes them here.
.\" usilic-rc-line # Not used in a terminal (CUI), where built-in row counts decide the level.
.\" usilic-rc-line
.\" usilic-rc-line 	1 2 4 8 16 30 40 50 60 70
.\" usilic-rc-line
.\" usilic-rc-line ARROW
.\" usilic-rc-line # Format: `usec1' `usec2' ...  (levels 1-, more than 10 values allowed)
.\" usilic-rc-line #
.\" usilic-rc-line # Per-level speed of inertial scrolling in the CUI (-c), same format as
.\" usilic-rc-line # SPEED, used both for the arrow keys on horizontal-text screens and for
.\" usilic-rc-line # left/right on vertical EPUB. Coasting started by a mouse drag starts two
.\" usilic-rc-line # levels faster (25000 with the values below); the arrow keys then use all
.\" usilic-rc-line # the levels. Without this section, SPEED is used.  The -g window does not
.\" usilic-rc-line # use it and runs with the SPEED values.
.\" usilic-rc-line #
.\" usilic-rc-line # Unlike -g, which scrolls by dots, the CUI scrolls by lines, so carrying the
.\" usilic-rc-line # drag speed straight into coasting would leave no slow speed suitable for
.\" usilic-rc-line # reading.  So coasting started by a drag starts two levels faster, and the
.\" usilic-rc-line # slow side is adjusted with the arrow keys.  There is no option like
.\" usilic-rc-line # usilic -s to try values, so edit the values here.
.\" usilic-rc-line
.\" usilic-rc-line 	200000 100000 25000 10000 5000 2000 1000 500 200 100 50 20
.\" usilic-rc-line
.\" usilic-rc-line URL
.\" usilic-rc-line # Format: `name  program  (option)'
.\" usilic-rc-line #
.\" usilic-rc-line # What to do when a web link (http etc.) in an EPUB body is followed with
.\" usilic-rc-line # [Enter] or a click.  ^Ow cycles through the lines in the order written and
.\" usilic-rc-line # shows the name (4 letters) on the mode-line; the first line is the default.
.\" usilic-rc-line # The entrances of the novel sites (Shosetsuka ni Naro, Shosetsu wo Yomo,
.\" usilic-rc-line # Nocturne Novels, Kakuyomu, Aozora Bunko) are always opened with Open, since
.\" usilic-rc-line # they are for finding a work ID (^Ow says "Open only" there).
.\" usilic-rc-line # The name is one of:
.\" usilic-rc-line #   Open  run program with the URL (open it in the default browser etc.)
.\" usilic-rc-line #   Pdf   make the whole page one tall PDF page with program (url2pdf), save
.\" usilic-rc-line #         it in ~/Downloads and open it with Quick Look (xdg-open on Linux).
.\" usilic-rc-line #         It runs a headless Chromium with Playwright, so this setup is
.\" usilic-rc-line #         needed (on Linux also playwright install-deps (sudo) and a
.\" usilic-rc-line #         Japanese font):
.\" usilic-rc-line #           python3 -m venv ~/.local/lib/usilic/venv
.\" usilic-rc-line #           ~/.local/lib/usilic/venv/bin/pip install playwright
.\" usilic-rc-line #           ~/.local/lib/usilic/venv/bin/python -m playwright install chromium
.\" usilic-rc-line #   Dump  read the output of program with the URL in usilic (^G back to the book)
.\" usilic-rc-line #   Term  run program with the URL in the terminal (like LAUNCH)
.\" usilic-rc-line #   Copy  pass the URL to program's standard input (copy to the clipboard)
.\" usilic-rc-line #   Look  Quick Look (macOS only, no program needed)
.\" usilic-rc-line #   Epub  for a usilic-web URL (src/web/README), download a book chosen from
.\" usilic-rc-line #         its shelf to ~/.local/usilic-web/texts and open it (curl is needed).
.\" usilic-rc-line #         For a link to a "Shosetsuka ni Naro", Kakuyomu or Aozora Bunko (card)
.\" usilic-rc-line #         work, make an EPUB with program (narou2epub) in ~/.usilic/data and
.\" usilic-rc-line #         open it
.\" usilic-rc-line #         (runs in SHELL). lxml, ebooklib, requests and Pillow are needed (see
.\" usilic-rc-line #         ~/.local/lib/usilic/narou2epub's comment)
.\" usilic-rc-line # Without this section the lines below are used (on Linux Open is xdg-open,
.\" usilic-rc-line # Copy is xclip -selection clipboard, and there is no Look; on Windows Open is
.\" usilic-rc-line # explorer.exe, Copy is clip.exe, and there is no Look; Pdf only when url2pdf
.\" usilic-rc-line # is installed, Epub only when narou2epub is installed).
.\" usilic-rc-line
.\" usilic-rc-line #	Open	open
.\" usilic-rc-line #	Pdf	~/.local/lib/usilic/url2pdf
.\" usilic-rc-line #	Dump	w3m -dump
.\" usilic-rc-line #	Term	w3m
.\" usilic-rc-line #	Copy	pbcopy
.\" usilic-rc-line #	Look
.\" usilic-rc-line #	Epub	~/.local/lib/usilic/narou2epub
.\" usilic-rc-line
.\" usilic-rc-line KEY
.\" usilic-rc-line # Key assignments.
.\" usilic-rc-line #
.\" usilic-rc-line # Format: F-n  keys    (defines prefix key F-0 .. F-4)
.\" usilic-rc-line #         K-n  keys    (the keys of function K-n)
.\" usilic-rc-line #
.\" usilic-rc-line # Each K-n number is the ID of its function, numbered in the order HELP
.\" usilic-rc-line # describes them (the KEY list shows them in that order too).  Neither the
.\" usilic-rc-line # order of the lines nor that of the numbers means anything, so the lines
.\" usilic-rc-line # may be rearranged freely.
.\" usilic-rc-line # Changing the keys of a function makes it work only with the new keys;
.\" usilic-rc-line # the old keys stop working (they can be given to another function).
.\" usilic-rc-line # Leaving the keys empty unassigns the function.  A number whose line is
.\" usilic-rc-line # removed keeps its default keys (with the new prefix if F-n was changed).
.\" usilic-rc-line #
.\" usilic-rc-line # Writing keys:
.\" usilic-rc-line #   F-n    prefix key F-n
.\" usilic-rc-line #   C-x    Ctrl+x (C-a .. C-z, C-[ C-\ C-] C-^ C-_, C-SPC)
.\" usilic-rc-line #   ESC    esc      SPC  space
.\" usilic-rc-line #   N      a number (the first digit 0-9 selects the function, further digits
.\" usilic-rc-line #          are typed after it; last only; only for functions that use N, such
.\" usilic-rc-line #          as ^JN and ^[N)
.\" usilic-rc-line #   other  that one character (# cannot be written)
.\" usilic-rc-line #
.\" usilic-rc-line # While typing at a prompt, in the SHELL window, or in a list you can type
.\" usilic-rc-line # into, only keys beginning with F-0/F-1/F-2/F-4 or ESC are replaced (one-
.\" usilic-rc-line # character keys and keys beginning with ^C are text or cancel there).
.\" usilic-rc-line # Giving the same keys to two functions, or keys that begin other keys, is
.\" usilic-rc-line # a usilicrc error, and the later one is unassigned.
.\" usilic-rc-line #
.\" usilic-rc-line     F-0   C-x     # ^X
.\" usilic-rc-line     F-1   C-j     # ^J
.\" usilic-rc-line     F-2   C-o     # ^O
.\" usilic-rc-line     F-3   C-c     # ^C
.\" usilic-rc-line     F-4   C-j C-o # ^J^O
.\" usilic-rc-line
.\" usilic-rc-line     K-1   j       # j     Scroll one line down
.\" usilic-rc-line     K-2   k       # k     Scroll one line up
.\" usilic-rc-line     K-3   C-n     # ^N    Move cursor one line down
.\" usilic-rc-line     K-4   C-p     # ^P    Move cursor one line up
.\" usilic-rc-line     K-5   SPC     # ␣     Page down / Quick Look
.\" usilic-rc-line     K-6   C-v     # ^V    Page down
.\" usilic-rc-line     K-7   C-f     # ^F    Page down
.\" usilic-rc-line     K-8   b       # b     Page up
.\" usilic-rc-line     K-9   C-b     # ^B    Page up
.\" usilic-rc-line     K-10  ESC v   # ^[v   Page up
.\" usilic-rc-line     K-11  ESC <   # ^[<   Go to top
.\" usilic-rc-line     K-12  ESC >   # ^[>   Go to bottom
.\" usilic-rc-line     K-13  ESC N   # ^[N   Go to N-th line
.\" usilic-rc-line     K-14  F-0 F-0 # ^X^X  Swap with line before big move
.\" usilic-rc-line     K-15  n       # n     Next file (pager)
.\" usilic-rc-line     K-16  p       # p     Previous file (pager)
.\" usilic-rc-line     K-17  x       # x     First file (pager)
.\" usilic-rc-line     K-18  f       # f     Last file (pager)
.\" usilic-rc-line     K-19  q       # q     Quit (pager)
.\" usilic-rc-line     K-20  C-g     # ^G    Return to previous mode
.\" usilic-rc-line     K-21  C-l     # ^L    Redraw
.\" usilic-rc-line     K-22  C-z     # ^Z    Suspend
