.in 0
.in 7n
.in 19n
.ti 7n
       ^I : tab
.in 0
.in 7n
.in 19n
.ti 7n
        ␣ : space
.in 0
.in 7n
.in 19n
.ti 7n
     ^J^H : ^J の後 ^H
.in 0
