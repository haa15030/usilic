.\" usilic-rc-line MACRO
.\" usilic-rc-line # キーボードマクロ。
.\" usilic-rc-line #
.\" usilic-rc-line # 書式: M-n  キー  K-n ...   (キーを押すと K-n の機能を順に実行)
.\" usilic-rc-line #
.\" usilic-rc-line # ^X( 〜 ^X) で記録したキーは、^Xe の直後の ^Xs で「--」の行へ書き足し、
.\" usilic-rc-line # 尋ねられたキー(1文字)で M-n として保存します(その場で効きます)。
.\" usilic-rc-line # 実行の間隔は WAIT で指定します。
.\" usilic-rc-line 	M-1  ;	K-20 K-4 K-28			# ^G^P^M	前の項目を開く
.\" usilic-rc-line 	M-2  :	K-20 K-3 K-28			# ^G^N^M	次の項目を開く
.\" usilic-rc-line 	M-3  [	K-35 K-4			# .^P		選択して上へ
.\" usilic-rc-line 	M-4  ]	K-35 K-3			# .^N		選択して下へ
.\" usilic-rc-line 	M-5  e	K-67				# ^[e		EDIT
