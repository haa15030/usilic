diff -ru ../usilic-1.5b.linux/config.sh ./config.sh
--- ../usilic-1.5b.linux/config.sh	Sat Jun  3 07:00:39 2000
+++ ./config.sh	Sat Jun  3 07:01:06 2000
@@ -7,7 +7,7 @@
 CHARSET="euc"
 
 # Command line for DU mode.
-DU="du -ab"
+DU="du -a"
 
 # CP/MV/RM mode.
 CP="cp -vRi"
@@ -15,22 +15,19 @@
 RM="rm -vri"
 
 echo 'Creating src/Makefile:'
-if [ `uname` = Linux ]; then	# Linux
-    MAN=/usr/man/man1
-    if [ ! "$USR_DIR" = "" ]; then 
-	JMAN=/usr/man/ja/man1
-    else
-	JMAN=/usr/man/ja_JP.ujis/man1
-    fi
-    USR_DIR=/usr
-    PERM='-m 644'
-    echo '# Makefile for Linux version' > .config
-    echo 'LIBS=	-lncurses'>> .config
+if [ `uname` = Linux ]; then    # Linux
+    patch -R -p0 -s < doc/patch.bsd
+    make install
+    exit 0
 else
-    if [ `uname` = FreeBSD ]; then	# FreeBSD
-        patch -p0 < doc/patch.bsd
-        make install
-        exit 0
+    if [ `uname` = FreeBSD ]; then      # FreeBSD
+        USR_DIR=/usr/local
+        COPY=-c
+        PERM='-m 444'
+        MAN=/usr/local/man/man1 
+	JMAN=/usr/local/man/ja/man1
+        echo '# Makefile for FreeBSD version' > .config
+        echo 'LIBS=     -ltermcap' >> .config
     else
         echo 'Not supported yet "'`uname`'".'
         exit 1
