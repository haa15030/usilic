diff -ru ../usilic-1.5b.linux/src/str.c ./src/str.c
--- ../usilic-1.5b.linux/src/str.c	Sat Jun  3 07:00:37 2000
+++ ./src/str.c	Sat Jun  3 07:01:07 2000
@@ -699,7 +699,17 @@
   Str.S[S_usilicrc] = cp;
   Str.S[S_code] = calloc(sizeof(char), 32);	/* S_code */
   Str.S[S_version] = strdup(version);
-  Str.S[S_path] = strdup(getenv("PATH"));	/* S_path */
+  if ((cp = strdup(getenv("PATH")))) {	/* S_path */
+    char *p, *p2, local[] = "/usr/local/bin";
+    if (!(p = strstr(cp, local)) 
+	|| ((p2 = strstr(cp, "/usr/bin")) && p2 < p)) {
+      p = alloca(strlen(local) + 2 + strlen(cp) + 1);
+      sprintf(p, "%s/:%s", local, cp);
+      Str.S[S_path] = strdup(p);
+      setenv("PATH", p, 1);
+    } else Str.S[S_path] = strdup(cp);
+  }
+  free(cp);
   Str.S[S_option+7] = malloc(strlen(s_S(S_usilic)) 
 			     + strlen(args) + 1);
   sprintf(Str.S[S_option+7], "%s%s", s_S(S_usilic), args);
