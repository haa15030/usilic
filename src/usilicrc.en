# usilicrc  version 1.5b
# -------------------------------------------------------------
# Blank lines, lines beginning with '#', and anything after a '#' are
# ignored.  A line beginning with one of the following names starts a
# section; the lines inside a section begin with a tab (or spaces).  Any
# other line is an error.
#
# ARCHIVE, FILTER, LAUNCH, GREP, PROGRAM, EDITOR, BUFFER, CODE, LINE,
# WAIT, COPY, MOVE, DELETE, SPEED, DRAG, ARROW, URL, KEY, MACRO
#
# usilicrc is the same file with Japanese comments.
# -------------------------------------------------------------

ARCHIVE
# Format: `newSuffix' `builtinSuffix'
#
# Each line adds `newSuffix' as an alias of a built-in archive suffix
# (the list below).  Listing and extracting are format-specific code, so a
# new format (its commands or how to read its listing) cannot be defined
# here.  It only works for files whose content is an existing format, like
# .cbz (a .zip inside).  An alias added here works everywhere in ARC mode
# (opening, listing, extracting, ^Oa, archives inside archives).
# .epub is a built-in alias of .zip.  [Enter] in (ls) opens it in EPUB mode
# (chapter list and text, vertical or horizontal as the book specifies);
# ^Oe lists its contents in ARC mode, and ^Oa extracts it.
#
# Built-in suffixes:
#  .tar        tar tvf
#  .tgz        gzip -dc | tar tvf -   (also .tar.gz .taz .tar.z)
#  .tar.bz2    bzip2 -dc | tar tvf -  (also .tbz2)
#  .tar.xz     xz -dc | tar tvf -     (also .txz)
#  .tar.zst    zstd -dc | tar tvf -   (also .tzst)
#  .lzh        lha
#  .zip        unzip -l               (also .jar)
#  .rpm        rpm -qplv
#  .deb        ar tv
#  .rar        lsar -l
#  .7z         7z l
#
# Examples:

#	.cbz	.zip
#	.apk	.zip
#	.cbr	.rar

FILTER
# Format: `suffix' `program' (option)
#
# The `program' displays the content of a file with the `suffix' as
# plain text.

	.gz	gzip	-dc
	.bz2	bzip2	-dc
	.z	gzip	-dc
	.xz	xz	-dc
	.lzma	xz	-dc
	.zst	zstd	-dc

LAUNCH
# Format: `suffix' `program' (option)
#
# The `program' is launched with a file that has the `suffix'.
#
# macOS note: a bare app name (e.g. IINA) is not a command on $PATH, so
# it cannot be launched.  Use `open' (the .mp4 examples below).  `open -a'
# needs an app name right after it, so `open -a file' takes the file as the
# app name and fails; to open with the default app, use plain `open'.
# On Homebrew, info comes with texinfo (brew install texinfo).
#
# On macOS, a file with no suffix here that CODE finds binary and that is
# an image, a PDF, or a type Quick Look handles (the list from
# `qlmanage -m plugins`: .numbers .key .pages .docx .xlsx, audio, movies,
# fonts etc.) is opened with Quick Look (qlmanage -p) instead of showing
# its type.

#	.mp4	open
#	.mp4	open	-a	IINA
	.info	info	-f
	.info.gz info	-f

GREP
# Format: `string'
#
# Search strings listed first, in this order, in the ^R list of EGREP and
# PART (regular expression); ^R again shows the history.
# (Enclose a string containing a space in "".)
#
# HELP's EGREP chapter examples, in the same order as its regular-
# expression list -- each one matches some text in HELP itself.
# Written for `grep -E' on both macOS (BSD grep) and Linux (GNU grep):
# \d/\D are spelled [0-9]/[^0-9], and grep -E has no non-greedy *?/+?,
# (?:...) or look-around, so those have no example.
#

	"^  [0-9]+\."            # ^     : chapter headings (1. 2. ...)
	）$                       # $     : lines ending with a full-width closing parenthesis
	\bls\b                   # \b    : ls as a word by itself
	usilic\B                 # \B    : the usilic of usilicrc
	m.n                      # .     : man
	\^[JOX][a-z]             # [ ]   : ^Jp ^Ou ^Xd etc.
	"\^[^JOX ]"              # [^ ]  : ^M ^[ ^K etc.
	[a-z]+\(1\)              # [a-z] : usilic(1) man(1) etc.
	[0-9]\.[0-9]\.           # \d    : section numbers such as 2.2.
	[0-9]+[^0-9][0-9]+       # \D    : 01/66 1.5 0x20 etc.
	\w+rc\b                  # \w    : usilicrc
	\^\W                     # \W    : ^[ ^@
	\^J\s                    # \s    : ^J b
	~/\S+                    # \S    : ~/.usilic/history etc.
	-[a-z]*v[a-z]*           # *     : -rvi -vf etc.
	[0-9]+%                  # +     : 48% etc.
	\.tar(\.gz)?             # ?     : .tar .tar.gz
	[0-9]{4}                 # {n}   : 1918 2000 etc.
	"^[^	].*	"              # \t    : HELP chapter headings (no leading tab, contains a tab)
	[0-9]{2,}                # {n,}  : numbers of 2 or more digits
	\b[a-z]{2,3}\(1\)        # {n,m} : ls(1) man(1) vi(1) etc.
	CP|MV|RM                 # |     : CP MV RM
	\.(gz|bz2|xz|zst)        # ( )   : suffixes of compression formats
	~/\.usilic/              # \.    : ~/.usilic/
	\(\?                     # \?    : (?: (?= etc.

PROGRAM
# Format: `program' (option)
#
# The programs launched by PROGRAM.

	jed
	mg
	vi
	less
	man
	lynx
	info
	top
	lv
	lv -Oe
	lv -Ir
	qlmanage -p

EDITOR
# Format: `editor'
#
# The editor launched by EDIT. The EDITOR environment variable, if set, takes precedence.

	pico
#	vi
#	jed

BUFFER
# Format: `size'
#
# The maximum size read into the buffer (in MB, 1-100; default 64).  A file
# larger than this is not read whole when opened with ^M etc.; it is opened
# like ^O^M, reading only what is shown.  Lists (ls, DU, LOCATE, archive
# contents), files extracted from an archive, MAN and ^[^M (read as is)
# stop reading at this size.  Either way "Not enough buffer" is shown
# (any key clears it).  Try a value with usilic -b; usilic -B writes it here.

	64

CODE
# Format: `code0' `code1' ...
#
# If a file without any of the suffixes above contains a control code
# under 0x20 that is not listed here, it is treated as a binary file:
# usilic runs file(1) and shows the code and the file type.  (If `code0'
# is 0, this check is not done.)
#

# ^A(TAGS)  ^G(BEL)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
   1         7        8   9  10  12  13  14      15      26       27       31

LINE
# Format: `line'
#
# The maximum number of lines kept per history kind (FILE, DIR, MAN,
# LOCATE, FGREP, EGREP, SHELL commands).  Beyond this, the oldest line is
# removed (USILIC keeps three times as many).  0 means unlimited (the
# default).  History never gets large enough to matter for memory, but
# ~/.usilic/history is rewritten whole each time an entry is added, so set
# a limit if saving starts to feel slow.  Try a value with usilic -l;
# usilic -L writes it here.

	0

WAIT
# Format: `wait'
#
# Macros are executed at intervals of `wait' (in units of 10 msec).  Try a
# value with usilic -w; usilic -W writes it here.  Editing this file with
# EDIT applies it at once, since usilic reads it again when it is saved (after
# editing it with another editor, ^Xs reads it again).

	1

COPY
# Format: `cp' (option)
#
# Command of CP.  (default: cp -vR)
#
# The macOS cp also copies extended attributes and resource forks (Finder tags
# and comments, the URL a file was downloaded from, etc.).  Where the
# destination cannot hold extended attributes (FAT/exFAT USB drives, some
# NAS, etc.), it puts them in a file named "._<name>" next to the copy (as
# Finder does; MV across disks does the same).  Seen from Windows or Linux,
# these "._" files look like files without content.  Even so, -X (do not copy
# extended attributes) is not the default:
#  1. Dropped metadata cannot be restored (extra "._" files can be removed
#     later, e.g. with dot_clean).
#  2. "._" files appear only when copying to a place that cannot hold
#     extended attributes (never when copying within APFS on the Mac).
# Write cp -vRX if you do not want "._" files.  The Linux (GNU) cp does not
# copy extended attributes with -vR anyway.
#

#	cp -vRi

MOVE
# Format: `mv' (option)
#
# Command of MV.  (default: mv -v)
#

#	mv -vi

DELETE
# Format: `rm' (option)
#
# Command of RM.  (default: rm -vr)
#

#	rm -vri

SPEED
# Format: `usec1' `usec2' ...  (levels 1-10)
#
# The speed of each inertial-scroll level: the time waited for each line
# (each dot with -g) moved, in usec, from level 1 (slowest) up.  Levels not
# given keep their built-in values.  Try values with usilic -s; usilic -S
# writes them here.

	90000 20000 10000 5000 3000 2000 1000 500 200 100

DRAG
# Format: `dot1' `dot2' ...  (levels 1-10)
#
# When a screen drag is released, the amount of motion (dots) just before
# that decides the inertial-scroll level: at least `dot1' for level 1,
# `dot2' for level 2, and so on.  Try values with usilic -d; usilic -D
# writes them here.
# Not used in a terminal (CUI), where built-in row counts decide the level.

	1 2 4 8 16 30 40 50 60 70

ARROW
# Format: `usec1' `usec2' ...  (levels 1-, more than 10 values allowed)
#
# Per-level speed of inertial scrolling in the CUI (-c), same format as
# SPEED, used both for the arrow keys on horizontal-text screens and for
# left/right on vertical EPUB. Coasting started by a mouse drag starts two
# levels faster (25000 with the values below); the arrow keys then use all
# the levels. Without this section, SPEED is used.  The -g window does not
# use it and runs with the SPEED values.
#
# Unlike -g, which scrolls by dots, the CUI scrolls by lines, so carrying the
# drag speed straight into coasting would leave no slow speed suitable for
# reading.  So coasting started by a drag starts two levels faster, and the
# slow side is adjusted with the arrow keys.  There is no option like
# usilic -s to try values, so edit the values here.

	200000 100000 25000 10000 5000 2000 1000 500 200 100 50 20

URL
# Format: `name  program  (option)'
#
# What to do when a web link (http etc.) in an EPUB body is followed with
# [Enter] or a click.  ^Ow cycles through the lines in the order written and
# shows the name (4 letters) on the mode-line; the first line is the default.
# The entrances of the novel sites (Shosetsuka ni Naro, Shosetsu wo Yomo,
# Nocturne Novels, Kakuyomu, Aozora Bunko) are always opened with Open, since
# they are for finding a work ID (^Ow says "Open only" there).
# The name is one of:
#   Open  run program with the URL (open it in the default browser etc.)
#   Pdf   make the whole page one tall PDF page with program (url2pdf), save
#         it in ~/Downloads and open it with Quick Look (xdg-open on Linux).
#         It runs a headless Chromium with Playwright, so this setup is
#         needed (on Linux also playwright install-deps (sudo) and a
#         Japanese font):
#           python3 -m venv ~/.local/lib/usilic/venv
#           ~/.local/lib/usilic/venv/bin/pip install playwright
#           ~/.local/lib/usilic/venv/bin/python -m playwright install chromium
#   Dump  read the output of program with the URL in usilic (^G back to the book)
#   Term  run program with the URL in the terminal (like LAUNCH)
#   Copy  pass the URL to program's standard input (copy to the clipboard)
#   Look  Quick Look (macOS only, no program needed)
#   Epub  for a usilic-web URL (src/web/README), download a book chosen from
#         its shelf to ~/.local/usilic-web/texts and open it (curl is needed).
#         For a link to a "Shosetsuka ni Naro", Kakuyomu or Aozora Bunko (card)
#         work, make an EPUB with program (narou2epub) in ~/.usilic/data and
#         open it
#         (runs in SHELL). lxml, ebooklib, requests and Pillow are needed (see
#         ~/.local/lib/usilic/narou2epub's comment)
# Without this section the lines below are used (on Linux Open is xdg-open,
# Copy is xclip -selection clipboard, and there is no Look; on Windows Open is
# explorer.exe, Copy is clip.exe, and there is no Look; Pdf only when url2pdf
# is installed, Epub only when narou2epub is installed).

#	Open	open
#	Pdf	~/.local/lib/usilic/url2pdf
#	Dump	w3m -dump
#	Term	w3m
#	Copy	pbcopy
#	Look
#	Epub	~/.local/lib/usilic/narou2epub

KEY
# Key assignments.
#
# Format: F-n  keys    (defines prefix key F-0 .. F-4)
#         K-n  keys    (the keys of function K-n)
#
# Each K-n number is the ID of its function, numbered in the order HELP
# describes them (the KEY list shows them in that order too).  Neither the
# order of the lines nor that of the numbers means anything, so the lines
# may be rearranged freely.
# Changing the keys of a function makes it work only with the new keys;
# the old keys stop working (they can be given to another function).
# Leaving the keys empty unassigns the function.  A number whose line is
# removed keeps its default keys (with the new prefix if F-n was changed).
#
# Writing keys:
#   F-n    prefix key F-n
#   C-x    Ctrl+x (C-a .. C-z, C-[ C-\ C-] C-^ C-_, C-SPC)
#   ESC    esc      SPC  space
#   N      a number (the first digit 0-9 selects the function, further digits
#          are typed after it; last only; only for functions that use N, such
#          as ^JN and ^[N)
#   other  that one character (# cannot be written)
#
# While typing at a prompt, in the SHELL window, or in a list you can type
# into, only keys beginning with F-0/F-1/F-2/F-4 or ESC are replaced (one-
# character keys and keys beginning with ^C are text or cancel there).
# Giving the same keys to two functions, or keys that begin other keys, is
# a usilicrc error, and the later one is unassigned.
#
    F-0   C-x     # ^X
    F-1   C-j     # ^J
    F-2   C-o     # ^O
    F-3   C-c     # ^C
    F-4   C-j C-o # ^J^O

    K-1   j       # j     Scroll one line down
    K-2   k       # k     Scroll one line up
    K-3   C-n     # ^N    Move cursor one line down
    K-4   C-p     # ^P    Move cursor one line up
    K-5   SPC     # ␣     Page down / Quick Look
    K-6   C-v     # ^V    Page down
    K-7   C-f     # ^F    Page down
    K-8   b       # b     Page up
    K-9   C-b     # ^B    Page up
    K-10  ESC v   # ^[v   Page up
    K-11  ESC <   # ^[<   Go to top
    K-12  ESC >   # ^[>   Go to bottom
    K-13  ESC N   # ^[N   Go to N-th line
    K-14  F-0 F-0 # ^X^X  Swap with line before big move
    K-15  n       # n     Next file (pager)
    K-16  p       # p     Previous file (pager)
    K-17  x       # x     First file (pager)
    K-18  f       # f     Last file (pager)
    K-19  q       # q     Quit (pager)
    K-20  C-g     # ^G    Return to previous mode
    K-21  C-l     # ^L    Redraw
    K-22  C-z     # ^Z    Suspend
    K-23  F-2 f   # ^Of   Show/hide mode-line
    K-24  F-1 C-c # ^J^C  Go to current directory
    K-25  C-]     # ^]    Go to the current directory (same as ^J^C)
    K-26  F-1 C-b # ^J^B  Go to parent directory
    K-27  F-1 N   # ^JN   Go to N-th directory
    K-28  C-m     # ^M    Open / show
    K-29  F-2 C-m # ^O^M  Read per line
    K-30  ESC C-m # ^[^M  Read as is
    K-31  F-1 F-1 # ^J^J  Go to previous file
    K-32  F-2 o   # ^Oo   Switch ls format
    K-33  F-2 l   # ^Ol   Cycle ls sort key
    K-34  F-2 C-l # ^O^L  Redraw (from SHELL) / reverse ls sort order
    K-35  .       # .     Toggle selection
    K-36  C-SPC   # ^SPC  Toggle selection
    K-37  F-2 y   # ^Oy   Select all
    K-38  F-2 n   # ^On   Clear all
    K-40  F-2 c   # ^Oc   CP
    K-41  F-2 m   # ^Om   MV
    K-42  F-2 r   # ^Or   RM
    K-43  F-1 t   # ^Jt   TOOL: input name
    K-44  F-1 C-t # ^J^T  TOOL: select from list
    K-45  F-2 u   # ^Ou   List of selected files (USILIC)
    K-46  F-2 a   # ^Oa   ARC: extract
    K-47  F-1 e   # ^Je   EPUB: input
    K-48  F-1 C-e # ^J^E  EPUB: list
    K-49  F-2 e   # ^Oe   ARC: contents of .epub
    K-50  C-r     # ^R    History list
    K-51  C-s     # ^S    Incremental search
    K-52  F-1 C-s # ^J^S  EGREP
    K-53  F-1 p   # ^Jp   PART: buffer
    K-106 F-1 C-p # ^J^P  PART: list (file "string" history)
    K-55  F-1 d   # ^Jd   DU: run du
    K-56  F-1 C-d # ^J^D  DU: back to result
    K-57  F-1 l   # ^Jl   LOCATE: build database
    K-58  F-1 C-l # ^J^L  LOCATE
    K-59  F-1 m   # ^Jm   MAN: input page
    K-60  F-1 C-m # ^J^M  MAN: select from list
    K-61  F-0 f   # ^Xf   FILE: input name
    K-62  F-0 C-f # ^X^F  FILE: select from list
    K-63  F-0 d   # ^Xd   DIR: input name
    K-64  F-0 C-d # ^X^D  DIR: select from list
    K-65  F-2 C-c # ^O^C  COPY
    K-66  F-2 C-y # ^O^Y  Paste
    K-67  ESC e   # ^[e   EDIT (e is a MACRO)
    K-68  ESC s   # ^[s   Go to SHELL
    K-69  F-1 s   # ^Js   Restart SHELL
    K-70  ESC l   # ^[l   SHELL log
    K-71  F-1 .   # ^J.   SHELL: cd to current directory
    K-72  F-1 ,   # ^J,   SHELL: ls -l
    K-73  F-1 w   # ^Jw   SHELL: insert access name
    K-74  F-1 C-w # ^J^W  SHELL: insert buffer content
    K-75  F-2 /   # ^O/   Search (from SHELL)
    K-76  F-2 C-f # ^O^F  Page down (from SHELL)
    K-77  F-2 C-b # ^O^B  Page up (from SHELL)
    K-78  ESC u   # ^[u   USILIC: contents
    K-79  F-1 C-u # ^J^U  USILIC: list by kind
    K-80  F-1 u   # ^Ju   USILIC: chronological
    K-81  F-0 C-w # ^X^W  Save buffer to work file
    K-82  C-i     # ^I    INFO
    K-83  F-1 C-i # ^J^I  INFO (from SHELL)
    K-84  F-4 u   # ^J^Ou ~/.usilic/usilicrc
    K-85  F-4 e   # ^J^Oe ERROR
    K-86  F-4 s   # ^J^Os SHELL log
    K-88  F-4 d   # ^J^Od ~/.usilic/data/
    K-89  F-4 w   # ^J^Ow WORK
    K-90  C-h     # ^H    HELP
    K-91  F-1 C-h # ^J^H  HELP
    K-92  F-2 j   # ^Oj   Switch HELP language
    K-107 F-2 d   # ^Od   Reverse the wheel direction
    K-93  C-k     # ^K    KEY
    K-94  F-1 C-k # ^J^K  KEY (from a prompt)
    K-95  F-0 (   # ^X(   Begin macro
    K-96  F-0 )   # ^X)   End macro
    K-97  F-0 e   # ^Xe   Execute macro
    K-98  F-0 s   # ^Xs   Reload usilicrc, save/list macros
    K-99  F-0 C-c # ^X^C  EXIT
    K-100 ESC ESC # ^[^[  EXIT
    K-101 F-2 s   # ^Os   EPUB: chapter breaks / continuous scroll
    K-102 F-2 w   # ^Ow   EPUB: cycle the web link action (URL)
    K-108 F-2 C-e # ^O^E  EPUB: list of records (made by vertical COPY)
    K-109 ESC [   # ^[[   -g: line spacing 1 dot narrower (between columns in vertical text)
    K-110 ESC ]   # ^[]   -g: line spacing 1 dot wider (between columns in vertical text)
    K-112 ESC {   # ^[{   -g: letter spacing 1 dot narrower (between characters in vertical text)
    K-113 ESC }   # ^[}   -g: letter spacing 1 dot wider (between characters in vertical text)
    K-111 F-2 t   # ^Ot   serif/sans-serif switch (-g, Japanese text outside EPUB)
    K-103 F-1 C-a # ^J^A  ARC: list (archives in the FILE history)
    K-104 F-1 C-f # ^J^F  -g: font list
    K-105 h       # h     From KEY to that line of plain HELP (else plain HELP)
#
# K-114 and later had no key assignment before (they were written in the program, 2026-10-23).
# K-132..K-138 work only in COPY, K-139..K-155 only while typing in a prompt; there they take
# the place of the K-n with the same default key (K-7 for ^F). ^N/^P, ^G, ^M, ^R, ^S, ^@, ^[N
# etc. in COPY and prompts share K-3, K-4, K-20, K-28 etc. (changing those changes these too).
    K-114 ESC g g # ^[gg  Go to line (same as ^[N)
    K-115 C-u     # ^U    Repeat count for the next command
    K-116 F-0 z   # ^Xz   Repeat the last command
    K-117 F-0 r m # ^Xrm  Set a bookmark
    K-118 F-0 r b # ^Xrb  Jump to a bookmark
    K-119 F-0 r l # ^Xrl  List bookmarks
    K-120 F-0 r SPC # ^Xr␣  Save this place to a register
    K-121 F-0 r C-SPC # ^Xr^␣ Save this place to a register (same as ^Xr␣)
    K-122 F-0 r j # ^Xrj  Jump to a register
    K-123 F-2 C-s # ^O^S  List of matching lines (FGREP)
    K-124 F-2 F-1 C-s # ^O^J^SList of matching lines (EGREP)
    K-125 %       # %     (ls): select names matching a regular expression
    K-126 *       # *     (ls): select files with the same suffix
    K-127 C-t n   # ^Tn   Next window
    K-128 C-t p   # ^Tp   Previous window
    K-129 C-t C-h # ^T^H  HELP window
    K-130 C-t C-k # ^T^K  KEY window
    K-131 e       # e     Right after ^Xe: repeat the macro (one key)
    K-132 C-f     # ^F    COPY: forward one character
    K-133 C-b     # ^B    COPY: back one character
    K-134 C-a     # ^A    COPY: beginning of line
    K-135 C-e     # ^E    COPY: end of line
    K-136 F-0 SPC # ^X␣   COPY: rectangle region
    K-137 ESC w   # ^[w   COPY: to the clipboard
    K-138 ESC t   # ^[t   COPY: to the TOOL prompt
    K-139 C-a     # ^A    Input: beginning of line
    K-140 C-e     # ^E    Input: end of line
    K-141 C-f     # ^F    Input: forward one character
    K-142 C-b     # ^B    Input: back one character
    K-143 C-d     # ^D    Input: delete the character at the cursor
    K-144 C-h     # ^H    Input: delete the previous character (DEL too)
    K-145 C-u     # ^U    Input: delete to the beginning
    K-146 C-k     # ^K    Input: delete to the end
    K-147 C-y     # ^Y    Input: yank the deleted text
    K-148 C-_     # ^_    Input: undo
    K-149 C-q     # ^Q    Input: insert the next key as is
    K-150 C-i     # ^I    Input: complete the path
    K-151 C-w     # ^W    Input: previous directory (CP/MV destination)
    K-152 ESC f   # ^[f   Input: forward one word
    K-153 ESC b   # ^[b   Input: back one word
    K-154 ESC d   # ^[d   Input: delete one word
    K-155 ESC C-h # ^[^H  Input: delete the previous word (^[DEL too)

MACRO
# Keyboard macros.
#
# Format: M-n  key  K-n ...   (the key runs the K-n functions in order)
#
# Keys recorded with ^X( ... ^X) are added at the "--" line by ^Xs right
# after ^Xe, and saved as M-n under the key (one letter) you are asked for
# (effective at once).  WAIT sets the interval between the keys.
	M-1  ;	K-20 K-4 K-28			# ^G^P^M	Open previous
	M-2  :	K-20 K-3 K-28			# ^G^N^M	Open next
	M-3  [	K-35 K-4			# .^P		Select, go up
	M-4  ]	K-35 K-3			# .^N		Select, go down
	M-5  e	K-67				# ^[e		EDIT
	M-6  l	K-86 K-53 "^usilic-1.5b:" K-28	# ^J^Os^Jp^usilic-1.5b:^M
	     	     	  		  	# PART SHELL in INFO by prompts
	--
