# usilicrc  version 1.5b
# -------------------------------------------------------------
# Blank lines, lines beginning with '#', and anything after a '#' are
# ignored.  A line beginning with one of the following names starts a
# section; the lines inside a section begin with a tab (or spaces).  Any
# other line is an error.
#
# ARCHIVE, FILE, EXEC, EGREP, PROGRAM, EDITOR, BUFFER, CODE, SHELL,
# HISTORY, WAIT, LS, SCROLL, CP, MV, RM, KEY
#
# usilicrc is the same file with Japanese comments.
# -------------------------------------------------------------

ARCHIVE
# Format: `newSuffix' `builtinSuffix'
#
# Each line adds `newSuffix' as an alias of a built-in archive suffix
# (the list below).  Listing and extracting are format-specific code, so a
# new format (its commands or how to read its listing) cannot be defined
# here.  It only works for files whose content is an existing format, like
# .epub or .cbz.  An alias added here works everywhere in ARC mode
# (opening, listing, extracting, ^Oa, archives inside archives).
#
# Built-in suffixes:
#  .tar        tar tvf
#  .tgz        gzip -dc | tar tvf -   (also .tar.gz .taz .tar.z)
#  .tar.bz2    bzip2 -dc | tar tvf -  (also .tbz2)
#  .tar.xz     xz -dc | tar tvf -     (also .txz)
#  .tar.zst    zstd -dc | tar tvf -   (also .tzst)
#  .lzh        lha
#  .zip        unzip -l               (also .jar)
#  .rpm        rpm -qplv
#  .deb        ar tv
#  .rar        lsar -l
#  .7z         7z l
#
# Examples:

#	.epub	.zip
#	.cbz	.zip
#	.apk	.zip
#	.cbr	.rar

FILE
# Format: `suffix' `program' (option)
#
# The `program' displays the content of a file with the `suffix' as
# plain text.

	.gz	gzip	-dc
	.bz2	bzip2	-dc
	.z	gzip	-dc
	.xz	xz	-dc
	.lzma	xz	-dc
	.zst	zstd	-dc

EXEC
# Format: `suffix' `program' (option)
#
# The `program' is launched with a file that has the `suffix'.
#
# macOS note: a bare app name (e.g. IINA) is not a command on $PATH, so
# it cannot be launched.  Use `open' (the .mp4 examples below).  `open -a'
# needs an app name right after it, so `open -a file' takes the file as the
# app name and fails; to open with the default app, use plain `open'.
# On Homebrew, info comes with texinfo (brew install texinfo).
#
# On macOS, a file with no suffix here that CODE finds binary and file(1)
# finds to be an image or a PDF (.jpg .png .bmp .tiff .pdf etc.) is opened
# with Quick Look (qlmanage -p) instead of showing its type.

#	.mp4	open
#	.mp4	open	-a	IINA
	.info	info	-f
	.info.gz info	-f

EGREP
# Format: `string'
#
# Search strings listed first, in this order, in the ^R list of EGREP and
# CUT (regular expression); ^R again shows the history.  The old section
# name GREP is also accepted.  (Enclose a string containing a space in "".)
#
# TUTORIAL's EGREP chapter examples, in the same order as its regular-
# expression list -- each one matches some text in TUTORIAL itself.
# Written for `grep -E' on both macOS (BSD grep) and Linux (GNU grep):
# \d/\D are spelled [0-9]/[^0-9], and grep -E has no non-greedy *?/+?,
# (?:...) or look-around, so those have no example.
#

	"^  [0-9]+\."            # ^     : 章の見出し(1. 2. ...)
	）$                       # $     : 全角の閉じ括弧で終わる行
	\bls\b                   # \b    : 単独の ls
	usilic\B                 # \B    : usilicrc の usilic
	m.n                      # .     : man
	\^[JOX][a-z]             # [ ]   : ^Jp ^Ou ^Xd など
	"\^[^JOX ]"              # [^ ]  : ^M ^[ ^K など
	[a-z]+\(1\)              # [a-z] : usilic(1) man(1) など
	[0-9]\.[0-9]\.           # \d    : 節番号 2.2. など
	[0-9]+[^0-9][0-9]+       # \D    : 01/66 1.5 0x20 など
	\w+rc\b                  # \w    : usilicrc
	\^\W                     # \W    : ^[ ^@
	\^J\s                    # \s    : ^J b
	~/\S+                    # \S    : ~/.usilic/history など
	-[a-z]*v[a-z]*           # *     : -rvi -vf など
	[0-9]+%                  # +     : 48% など
	\.tar(\.gz)?             # ?     : .tar .tar.gz
	[0-9]{4}                 # {n}   : 1918 2000 など
	[0-9]{2,}                # {n,}  : 2桁以上の数
	\b[a-z]{2,3}\(1\)        # {n,m} : ls(1) man(1) vi(1) など
	CP|MV|RM                 # |     : CP MV RM
	\.(gz|bz2|xz|zst)        # ( )   : 圧縮形式の suffix
	~/\.usilic/              # \.    : ~/.usilic/
	\(\?                     # \?    : (?: (?= など

PROGRAM
# Format: `program' (option)
#
# The programs launched by PROGRAM.

	jed
	mg
	vi
	less
	man
	lynx
	info
	top
	lv
	lv -Oe
	lv -Ir
	qlmanage -p

EDITOR
# Format: `editor'
#
# The editor launched by EDIT.

	vi
#	jed

BUFFER
# Format: `size'
#
# The maximum size read into the buffer (in MB, 1-100; default 64).  A file
# larger than this is not read whole when opened with ^M etc.; it is opened
# like ^O^M, reading only what is shown.  Lists (ls, DU, LOCATE, archive
# contents), files extracted from an archive, MAN and ^[^M (read as is)
# stop reading at this size.  Either way "Not enough buffer" is shown
# (any key clears it).

	64

CODE
# Format: `code0' `code1' ...
#
# If a file without any of the suffixes above contains a control code
# under 0x20 that is not listed here, it is treated as a binary file:
# usilic runs file(1) and shows the code and the file type.  (If `code0'
# is 0, this check is not done.)
#

# ^A(TAGS)  ^G(BEL)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
   1         7        8   9  10  12  13  14      15      26       27       31

SHELL
# Format: `shell'
#
# The shell launched by SHELL mode.  If the environment variable SHELL is
# bash, zsh, tcsh or csh, that one is used, and this setting is used only
# otherwise (fish etc.).  Without this setting either, bash is used.  SHELL
# mode supports bash, zsh, tcsh and csh.

	bash
#	tcsh

HISTORY
# Format: `line'
#
# The maximum number of lines kept per history kind (FILE, DIR, MAN,
# LOCATE, FGREP, EGREP, SHELL commands).  Beyond this, the oldest line is
# removed (USILIC keeps three times as many).  0 means unlimited (the
# default).  History never gets large enough to matter for memory, but
# ~/.usilic/history is rewritten whole each time an entry is added, so set
# a limit if saving starts to feel slow.

	0

WAIT
# Format: `wait'
#
# Macros are executed at intervals of `wait' (in units of 10 msec).

	1

LS
# Format: `flag'
#
# The initial ls display format (switched by ^Oo afterwards).  When set,
# only file names are shown.

	0

SCROLL
# Format: `flag'
#
# The initial scroll mode (at startup only; ^Oh switches the mode-line on
# and off).  When set, the window scrolls within the range above the
# bottom line.

	0

CP
# Format: `cp' (option)
#
# Command of CP.  (default: cp -vR)
#

#	cp -vRi

MV
# Format: `mv' (option)
#
# Command of MV.  (default: mv -v)
#

#	mv -vi

RM
# Format: `rm' (option)
#
# Command of RM.  (default: rm -vr)
#

#	rm -vri

KEY
# Key assignments.
#
# Format: F-n  keys    (defines prefix key F-0 .. F-4)
#         K-n  keys    (the keys of function K-n)
#
# Each K-n number is a fixed ID of its function: neither the order of the
# lines nor that of the numbers means anything, so the lines may be
# rearranged freely (a new function gets the next number at the end).
# Changing the keys of a function makes it work only with the new keys;
# the old keys stop working (they can be given to another function).
# Leaving the keys empty unassigns the function.  A number whose line is
# removed keeps its default keys (with the new prefix if F-n was changed).
#
# Writing keys:
#   F-n    prefix key F-n
#   C-x    Ctrl+x (C-a .. C-z, C-[ C-\ C-] C-^ C-_, C-SPC)
#   ESC    esc      SPC  space
#   N      any digit 0-9 (last only; only for functions that use N, such
#          as ^JN and ^[N)
#   other  that one character (# cannot be written)
#
# While typing at a prompt, in the SHELL window, or in a list you can type
# into, only keys beginning with F-0/F-1/F-2/F-4 or ESC are replaced (one-
# character keys and keys beginning with ^C are text or cancel there).
# Giving the same keys to two functions, or keys that begin other keys, is
# a usilicrc error, and the later one is unassigned.
#
	F-0	C-x         # ^X
	F-1	C-j         # ^J
	F-2	C-o         # ^O
	F-3	C-c         # ^C
	F-4	C-j C-o     # ^J^O

	K-1	C-g         # ^G     Return to previous mode
	K-2	C-p         # ^P     Move cursor one line up
	K-3	C-n         # ^N     Move cursor one line down
	K-4	;           # ;      Open previous entry
	K-5	:           # :      Open next entry
	K-6	C-i         # ^I     INFO
	K-7	e           # e      EDIT
	K-8	F-2 C-i     # ^O^I   INFO (from SHELL)
	K-9	p           # p      Previous file (pager)
	K-10	n           # n      Next file (pager)
	K-11	x           # x      First file (pager)
	K-12	f           # f      Last file (pager)
	K-13	q           # q      Quit (pager)
	K-14	C-m         # ^M     Open / show
	K-15	F-0 d       # ^Xd    DIR: input name
	K-16	F-1 C-c     # ^J^C   Go to current directory
	K-17	F-1 C-k     # ^J^K   Go to parent directory
	K-18	F-1 N       # ^JN    Go to N-th directory
	K-19	F-0 f       # ^Xf    FILE: input name
	K-20	F-0 C-f     # ^X^F   FILE: select from list
	K-21	F-2 C-m     # ^O^M   Read per line
	K-22	ESC C-m     # ^[^M   Read as is
	K-23	F-1 F-1     # ^J^J   Go to previous file
	K-24	.           # .      Toggle selection
	K-25	[           # [      Select and move up
	K-26	]           # ]      Select and move down
	K-27	F-2 y       # ^Oy    Select all
	K-28	F-2 n       # ^On    Clear all
	K-29	F-2 u       # ^Ou    List of selected files (USILIC)
	K-30	F-2 c       # ^Oc    CP
	K-31	F-2 m       # ^Om    MV
	K-32	F-2 r       # ^Or    RM
	K-33	F-1 p       # ^Jp    PROGRAM: input name
	K-34	F-1 C-p     # ^J^P   PROGRAM: select from list
	K-35	SPC         # ␣      Page down / Quick Look
	K-36	F-2 s       # ^Os    Restart SHELL
	K-37	F-2 a       # ^Oa    ARC: extract
	K-38	C-r         # ^R     History list
	K-39	C-s         # ^S     Incremental search
	K-40	F-1 C-s     # ^J^S   EGREP
	K-41	F-3 b       # ^Cb    CUT: buffer
	K-42	F-3 f       # ^Cf    CUT: file
	K-43	F-1 d       # ^Jd    DU: run du
	K-44	F-1 C-d     # ^J^D   DU: back to result
	K-45	F-1 l       # ^Jl    LOCATE: build database
	K-46	F-1 C-l     # ^J^L   LOCATE
	K-47	F-1 m       # ^Jm    MAN: input page
	K-48	F-1 C-m     # ^J^M   MAN: select from list
	K-49	F-0 C-d     # ^X^D   DIR: select from list
	K-50	F-2 C-c     # ^O^C   COPY
	K-51	F-2 C-y     # ^O^Y   Paste
	K-52	F-4 e       # ^J^Oe  ERROR
	K-53	F-4 s       # ^J^Os  SHELL log
	K-54	ESC l       # ^[l    SHELL log
	K-55	ESC s       # ^[s    Go to SHELL
	K-56	F-1 .       # ^J.    SHELL: cd to current directory
	K-57	F-1 ,       # ^J,    SHELL: ls -l
	K-58	F-1 w       # ^Jw    SHELL: insert access name
	K-59	F-1 C-w     # ^J^W   SHELL: insert buffer content
	K-60	F-2 /       # ^O/    Search (from SHELL)
	K-61	F-2 C-f     # ^O^F   Page down (from SHELL)
	K-62	F-2 C-b     # ^O^B   Page up (from SHELL)
	K-63	F-2 C-l     # ^O^L   Redraw (from SHELL) / cycle ls sort key
	K-64	F-0 C-c     # ^X^C   EXIT
	K-65	ESC ESC     # ^[^[   EXIT
	K-66	F-2 o       # ^Oo    Switch ls format
	K-67	F-2 h       # ^Oh    Show/hide mode-line
	K-68	F-0 C-w     # ^X^W   Save buffer to work file
	K-69	C-z         # ^Z     Suspend
	K-70	j           # j      Scroll one line down
	K-71	k           # k      Scroll one line up
	K-72	C-f         # ^F     Page down
	K-73	C-v         # ^V     Page down
	K-74	b           # b      Page up
	K-75	C-b         # ^B     Page up
	K-76	ESC v       # ^[v    Page up
	K-77	ESC <       # ^[<    Go to top
	K-78	ESC >       # ^[>    Go to bottom
	K-79	ESC N       # ^[N    Go to N-th line
	K-80	F-0 F-0     # ^X^X   Swap with line before big move
	K-81	F-1 C-u     # ^J^U   USILIC: list by kind
	K-82	F-1 u       # ^Ju    USILIC: chronological
	K-83	F-1 a       # ^Ja    Switch TUTORIAL language
	K-84	F-2 g       # ^Og    Switch GUI
	K-85	F-2 l       # ^Ol    Reverse ls sort order
	K-86	C-l         # ^L     Redraw
	K-87	C-SPC       # ^SPC   Toggle selection
	K-88	ESC P       # ^[P    Paste transient targets
	K-89	ESC u       # ^[u    USILIC: contents
	K-90	C-t         # ^T     TUTORIAL
	K-91	C-h         # ^H     HELP
	K-92	F-1 C-h     # ^J^H   HELP
	K-93	F-0 (       # ^X(    Begin macro
	K-94	F-0 )       # ^X)    End macro
	K-95	F-0 e       # ^Xe    Execute macro
	K-96	F-4 d       # ^J^Od  ~/.usilic/data/
	K-97	F-4 w       # ^J^Ow  WORK
