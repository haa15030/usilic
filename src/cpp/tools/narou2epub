#!/bin/sh
# narou2epub Nコード|作品のURL ... [-o 出力ディレクトリ(既定は~/.usilic/data)] -- 「小説家になろう」(2026-10-13から
# 「カクヨム」の作品ID・kakuyomu.jp/works/<ID>も、2026-10-15から青空文庫の図書カード・XHTML版のURLも)の作品を
# EPUB3にし(青空文庫は縦書き。2026-10-23からArchive of Our Ownの作品のURLも、サイトのEPUBをそのまま落とす)、作ったEPUBの
# パスを1行ずつ標準出力へ書く(途中の経過は標準エラー)。2026-10-11、NarouToEpub3(Apache-2.0、
# narou2epub-assets/LICENSE)を改変したnarou2epub.pyを、このファイルの隣のvenv(url2pdfと同じ)で動かす。準備:
#   python3 -m venv ~/.local/lib/usilic/venv
#   ~/.local/lib/usilic/venv/bin/pip install lxml ebooklib requests Pillow
# 作ったEPUBは個人で楽しむためだけに使い、他人に配布しないこと(作品の著作権は作者にある)。
here=$(cd "$(dirname "$0")" && pwd)
python=python3
for candidate in "$USILIC_VENV/bin/python" "$here/venv/bin/python" "$HOME/.local/lib/usilic/venv/bin/python"; do
  if [ -x "$candidate" ]; then python=$candidate; break; fi
done
# 2026-11-07、直接のユーザー報告(^J^Eで"No module named 'requests'"、git pullしたminiでも): venvを作る手順は
# 上の「準備」のコメントにしか無く、venvが無い(またはライブラリの足りない)環境ではpython3のままで失敗していた。
# 足りなければ、初めての1回だけvenvを作って入れる(経過は標準エラー。標準出力はEPUBのパスだけ)。
if [ "$1" != "-h" ] && [ "$1" != "--help" ] &&
   ! "$python" -c 'import requests, lxml, ebooklib, PIL' 2>/dev/null; then
  venv=${USILIC_VENV:-$HOME/.local/lib/usilic/venv}
  echo "narou2epub: $venv へ lxml ebooklib requests Pillow を入れます(初めての1回だけ)" >&2
  # 2026-11-17、直接のユーザー報告(Debian 13・Ubuntu 26.10で"ensurepip is not available"): Debian系は
  # python3-venvが無いとvenvがpip無しの作りかけで残り、python3-venvを入れた後も次からは作り直さずに
  # pipで失敗し続ける。pipの無いvenvは消して作り直し、作れない時はDebian系の入れ方を出す。
  if [ -x "$venv/bin/python" ] && ! "$venv/bin/python" -m pip --version >/dev/null 2>&1; then
    rm -rf "$venv"
  fi
  if [ ! -x "$venv/bin/python" ]; then
    command -v python3 >/dev/null 2>&1 || { echo "narou2epub: python3 が見つかりません" >&2; exit 1; }
    if ! python3 -m venv "$venv" >&2; then
      rm -rf "$venv"
      [ -r /etc/debian_version ] &&
        echo "narou2epub: Debian・Ubuntuでは先に sudo apt-get install python3-venv を実行してください" >&2
      exit 1
    fi
  fi
  "$venv/bin/python" -m pip install lxml ebooklib requests Pillow >&2 || exit $?
  python=$venv/bin/python
fi
case "$1" in -*) ;; *) set -- -n "$@" ;; esac
# usilicのSHELL(USILICが立っている、^Jtで打った時も)の中なら、作り終えたら最後のEPUBを`usilic`で親のusilicへ
# 渡して開く(2026-10-11)。途中の経過は標準エラーなのでそのままSHELLに見える。
if [ -n "$USILIC" ] && [ "$1" != "-h" ] && [ "$1" != "--help" ]; then
  out=$("$python" "$here/narou2epub.py" "$@") || exit $?
  printf '%s\n' "$out"
  last=$(printf '%s\n' "$out" | tail -n 1)
  if [ -n "$last" ] && [ -f "$last" ]; then exec usilic "$last"; fi
  exit 0
fi
exec "$python" "$here/narou2epub.py" "$@"
