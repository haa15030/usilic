BUFFER
# 書式: サイズ
#
# バッファへ読み込む最大サイズ(単位は MB、1〜100。既定は 64)。これを超える
# file は ^M 等で開くと全体を読み込まず、^O^M と同じく画面に出る分だけ
# 読み込む方法で開きます。一覧(ls、DU、LOCATE、アーカイブの内容)や
# アーカイブから取り出した file、MAN、^[^M(そのまま読む)は、ここまでで
# 読み込みを止めます。どちらの場合も「Not enough buffer」を表示します
# (どれかのキーで消えます)。usilic -b で試し、usilic -B でここへ書き込めます。

	64

CODE
# 書式: code0  code1 ...
#
# 上の suffix を持たない file に、ここに無い 0x20 未満の制御コードが含まれて
# いれば、バイナリファイルとみなして file(1) を実行し、その制御コードと
# ファイルの種類を表示します(code0 が 0 ならこの判定をしません)。
#

# ^A(TAGS)  ^G(BEL)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
   1         7        8   9  10  12  13  14      15      26       27       31

LINE
# 書式: 行数
#
# 履歴(FILE、DIR、MAN、LOCATE、FGREP、EGREP、SHELL のコマンド)を種類ごとに
# 残す最大の行数。これを超えると古い行から消えます(USILIC はその 3 倍)。
# 0 は無制限です(既定)。履歴はメモリの面では何年分でも問題にならない
# 規模ですが、~/.usilic/history は項目が増えるたびに全体を書き直すので、
# 保存が重く感じるようになったら上限を付けてください。usilic -l で試し、
# usilic -L でここへ書き込めます。

	0

WAIT
# 書式: wait
#
# マクロを wait(単位は 10 msec)の間隔で実行します。usilic -w で試し、
# usilic -W でここへ書き込めます。EDIT でこのファイルを直す(または ^Xs)と、
# その場で効きます。

	1

COPY
# 書式: cp  (option)
#
# CP のコマンド。(既定: cp -vR)
#
# macOS の cp は、拡張属性とリソースフォーク(Finder のタグ・コメント、
# ダウンロード元の URL 等)も一緒にコピーします。コピー先が拡張属性を持てない
# 所(FAT・exFAT の USB メモリ、一部の NAS 等)では、それを「._ファイル名」と
# いうファイルに入れて隣に置きます(Finder と同じ。MV でディスクをまたぐ時も)。
# Windows や Linux で見ると、この「._」が中身の無いファイルのように見えます。
# それでも既定では -X(拡張属性をコピーしない)を付けません。
#  1. 落とした付加情報は戻せません(余分な「._」は dot_clean 等で後から
#     消せます)。
#  2. 「._」ができるのは拡張属性を持てない所へコピーする時だけです(Mac の中の
#     APFS へのコピーではできません)。
# 「._」が要らなければ cp -vRX と書いてください。Linux の cp(GNU)は -vR では
# 元々拡張属性をコピーしません。
#

#	cp -vRi

MOVE
# 書式: mv  (option)
#
# MV のコマンド。(既定: mv -v)
#

#	mv -vi

DELETE
# 書式: rm  (option)
#
# RM のコマンド。(既定: rm -vr)
#

#	rm -vri

SERIF
# 書式: フォントファイル
#
# -g で明朝体(serif)に使うフォント。EPUB の本文等、CSS で明朝体と指定された
# 字をこのフォントで描きます。上から順に試し、使える最初のものを使います。
# 無ければ組み込みの候補(ヒラギノ明朝 ProN、Noto Serif CJK 等)を使います。

#	/System/Library/Fonts/ヒラギノ明朝 ProN.ttc

SANS-SERIF
# 書式: フォントファイル
#
# -g でゴシック体(sans-serif)に使う和文のフォント。画面の全角の字(EPUB で
# ゴシック体と指定された字を含む)をこのフォントで描きます。上から順に試し、
# 使える最初のものを使います。無ければ組み込みの候補(ヒラギノ角ゴシック、
# Noto Sans CJK 等)を使います。

#	/System/Library/Fonts/ヒラギノ角ゴシック W4.ttc

SPEED
# 書式: usec1  usec2 ...  (段1〜10)
#
# 慣性スクロールの段ごとの速さ。1 行(-g では 1 ドット)進むごとに待つ時間を
# 段 1(最も遅い)から順に、単位 usec で書きます。足りない段は組み込みの値の
# ままです。usilic -s で試し、usilic -S でここへ書き込めます。

	90000 20000 10000 5000 3000 2000 1000 500 200 100

DRAG
# 書式: dot1  dot2 ...  (段1〜10)
#
# 画面をドラッグして離した時に、その直前の動きの量(ドット)がいくつ以上なら
# 段 1、段 2 ...の慣性スクロールになるか。usilic -d で試し、usilic -D でここへ
# 書き込めます。

	1 2 4 8 16 30 40 50 60 70

ARROW
# 書式: usec1  usec2 ...  (段1〜、10 個より多くてもよい)
#
# CUI(-c)の慣性スクロールの段ごとの速さ(書式は SPEED と同じ)。横書きの画面
# の矢印キーと、縦書きの EPUB の左右の両方に使います。マウスのドラッグで始めた
# 慣性は 2 つ速い方へずらした段(下の値なら 25000)から始まり、その後の矢印
# キーでは全部の段を使えます。この節が無ければ SPEED の値。-g の画面では使わず、
# SPEED の値で動きます。
#
# ドット単位でスクロールする -g と違い、CUI は行単位でスクロールするので、
# ドラッグの速さをそのまま慣性につなげると、読むのに向いた低速が使えません。
# そこでドラッグで始めた慣性は 2 段速い方から始め、低速は矢印キーで合わせる
# ようにしています。usilic -s のような試すオプションは無いので、ここの値を
# 直して調整してください。

	200000 100000 25000 10000 5000 2000 1000 500 200 100 50 20

FONT
# 書式: フォントファイル
#
# -g の画面の基本の(半角の)等幅フォント。全角の字は SANS-SERIF、明朝体は
# SERIF のフォントで描きます。無ければ組み込みの候補を使います。usilic -f で
# 試し、usilic -F でここへ書き込めます。

#	/Library/Fonts/MS-Gothic.ttf

LINE-HEIGHT
# 書式: 横書き  縦書き
#
# -g の画面の 1 行の高さを、字の大きさに対する倍率で書きます(CSS の
# line-height と同じ)。横書きは行と行の間、縦書きの EPUB は 1 行に 1 字を
# 置くので字と字の間になります(1.0 で「……」がつながります)。縦書きの画面
# ではそちらの値に切り替わり、窓の大きさはそのままで行数が変わります。縦書き
# を省けば横書きと同じ値。
# この節が無ければ、フォントの行の高さを使います。
# EDIT でこのファイルを直す(または ^Xs)と、その場で効きます。-g の画面では
# ^[[ / ^[] で、今の向き(横書き・縦書き)の行の高さを 1 ドットずつ増減でき
# ます(ここには書き込みません。増減した分は次の起動にも引き継ぎ、このファイルを
# 読み直すとここの値に戻ります)。

	1.2  1.0

URL
# 書式: 名前  program  (option)
#
# EPUB の本文の Web のリンク(http 等)を [Enter]・クリックで踏んだ時の対処。
# 書いた順に ^Ow で巡回し、名前(4文字)を mode-line に表示します。最初の行が
# 既定です。ただし小説サイト(「小説家になろう」・「小説を読もう」・
# 「ノクターンノベルズ」・「カクヨム」・「青空文庫」)の入口は、作品の番号を
# 探す所なので常に Open で開きます(^Ow は「Open only」)。名前は次のどれかです。
#   Open  program に URL を渡して起動(既定のブラウザで開く等)
#   Pdf   program(url2pdf)でページ全体を縦長の 1 ページの PDF にして
#         ~/Downloads へ保存し、クイックルックで開く(Linux は xdg-open)。
#         画面無しの Chromium を Playwright で動かすので、次の準備が
#         要ります(Linux ではさらに playwright install-deps(要 sudo)と
#         日本語フォント)。
#           python3 -m venv ~/.local/lib/usilic/venv
#           ~/.local/lib/usilic/venv/bin/pip install playwright
#           ~/.local/lib/usilic/venv/bin/python -m playwright install chromium
#   Dump  program に URL を渡した出力を usilic の画面で読む(^G で本へ戻る)
#   Term  program に URL を渡して端末で起動(LAUNCH と同じ、終われば本へ戻る)
#   Copy  program の標準入力へ URL を渡す(クリップボードへコピー)
#   Look  クイックルック(macOS だけ、program は不要)
#   Epub  usilic-web(src/web/README)の URL なら、本棚の一覧から選んだ本を
#         ~/.local/usilic-web/texts へ落として開く(curl が要ります)。
#         「小説家になろう」・「カクヨム」・青空文庫(図書カード)の作品のリンクなら、
#         program(narou2epub)で
#         ~/.usilic/data に EPUB を作って開く(SHELL で動く)。lxml・
#         ebooklib・requests・Pillow が要ります(~/.local/lib/usilic/narou2epub
#         のコメント参照)
# この節が無ければ下の内容(Linux は Open が xdg-open、Copy が
# xclip -selection clipboard、Look は無し。Windows は Open が explorer.exe、
# Copy が clip.exe、Look は無し。Pdf は url2pdf、Epub は narou2epub がある時
# だけ)を使います。

#	Open	open
#	Pdf	~/.local/lib/usilic/url2pdf
#	Dump	w3m -dump
#	Term	w3m
#	Copy	pbcopy
#	Look
#	Epub	~/.local/lib/usilic/narou2epub

KEY
# キーの割り当て。
#
# 書式: F-n  キー    (接頭キー F-0〜F-4 の定義)
#       K-n  キー    (機能 K-n のキー)
#
# K-n の番号は機能ごとの ID で、HELP の記載順に振ってあります(KEY の一覧も
# その順)。行の順序や番号の並びに意味は無く、行を並べ替えてもキーと機能の
# 組み合わせは変わりません。キーを変えると、その機能は新しい
# キーでだけ動き、元のキーは効かなくなります(元のキーを別の機能に
# 割り当てることもできます)。キーを空にすると、その機能は割り当て無しに
# なります。行を消した番号は、既定のキーのまま(接頭キー F-n を変えていれば
# 新しい接頭キー)で動きます。
#
# キーの書き方:
#   F-n    接頭キー F-n
#   C-x    Ctrl+x(C-a〜C-z、C-[ C-\ C-] C-^ C-_、C-SPC)
#   ESC    esc      SPC  space
#   N      数字 0〜9 のいずれか(末尾のみ。^JN や ^[N のように N を使う機能だけ)
#   その他 その 1 文字(# は書けません)
#
# プロンプトの入力中、SHELL 画面、文字を入力する一覧では、F-0/F-1/F-2/F-4
# または ESC で始まるキーだけが置き換わります(1 文字のキーや ^C で始まる
# キーは、そこでは文字や入力の中断として扱われます)。同じキーを二つの機能に
# 割り当てたり、あるキーが別のキーの頭になっていたりすると、usilicrc の
# エラーとして後の方が割り当て無しになります。
#
	F-0	C-x         # ^X
	F-1	C-j         # ^J
	F-2	C-o         # ^O
	F-3	C-c         # ^C
	F-4	C-j C-o     # ^J^O

	K-1	j           # j       画面を1行下へ
	K-2	k           # k       画面を1行上へ
	K-3	C-n         # ^N      カーソルを1行下へ
	K-4	C-p         # ^P      カーソルを1行上へ
	K-5	SPC         # ␣       ページ送り/クイックルック
	K-6	C-v         # ^V      ページ送り
	K-7	C-f         # ^F      ページ送り
	K-8	b           # b       ページ戻し
	K-9	C-b         # ^B      ページ戻し
	K-10	ESC v       # ^[v     ページ戻し
	K-11	ESC <       # ^[<     先頭へ
	K-12	ESC >       # ^[>     末尾へ
	K-13	ESC N       # ^[N     N行目へ
	K-14	F-0 F-0     # ^X^X    大きく移動する前の行と行き来
	K-15	n           # n       次のfile(pager)
	K-16	p           # p       前のfile(pager)
	K-17	x           # x       最初のfile(pager)
	K-18	f           # f       最後のfile(pager)
	K-19	q           # q       pagerの終了
	K-20	C-g         # ^G      前のモードへ戻る
	K-21	C-l         # ^L      再表示
	K-22	C-z         # ^Z      サスペンド
	K-23	F-2 f       # ^Of     mode-line の表示/非表示
	K-24	F-1 C-c     # ^J^C    カレントディレクトリへ
	K-25	C-]         # ^]      カレントディレクトリへ(^J^Cと同じ)
	K-26	F-1 C-b     # ^J^B    親ディレクトリへ
	K-27	F-1 N       # ^JN     N番目のディレクトリへ
	K-28	C-m         # ^M      開く/表示
	K-29	F-2 C-m     # ^O^M    1行ずつ読む
	K-30	ESC C-m     # ^[^M    そのまま読む
	K-31	F-1 F-1     # ^J^J    以前のfileへ
	K-32	F-2 o       # ^Oo     ls の表示形式
	K-33	F-2 l       # ^Ol     ls のソートキー巡回
	K-34	F-2 C-l     # ^O^L    再表示(SHELL内から)/ls のソート順を逆順に
