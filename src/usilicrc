# usilicrc  version 1.5b
# -------------------------------------------------------------
# 空行と、'#' で始まる行(および行中の '#' 以降)は無視されます。
# 行頭が以下の見出しの行が節の始まりで、節の中身の行はタブ(または空白)で
# 始めます。それ以外の文字で始まる行はエラーになります。
#
# ARCHIVE, FILE, EXEC, EGREP, PROGRAM, EDITOR, BUFFER, CODE, SHELL,
# LINE, WAIT, CP, MV, RM, SERIF, SANS-SERIF, SPEED, DRAG, ARROW, FONT, URL, KEY, MACRO
#
# 英語のコメント付きの同じ内容のファイルが usilicrc.en です。
# -------------------------------------------------------------

ARCHIVE
# 書式: 新しいsuffix  組み込みのsuffix
#
# 組み込みのアーカイブの suffix(下の一覧)に、新しい suffix を別名として
# 追加します。アーカイブの一覧や取り出しは形式ごとに専用の処理なので、
# 新しい形式(コマンドや一覧の読み方)をここで定義することはできません。
# 使えるのは、.epub や .cbz のように中身が既存の形式であるファイルだけ
# です。ここで足した別名は、ARC モード(開く、一覧、取り出し、^Oa、
# アーカイブの中のアーカイブ)の全てで効きます。
# .epub は組み込みで .zip の別名です。(ls) の [Enter] では EPUB モード(章の
# 一覧と本文、縦横は本の指定どおり)で開き、^Oe で ARC として中身を一覧、
# ^Oa で展開できます。
#
# 組み込みの suffix:
#  .tar        tar tvf
#  .tgz        gzip -dc | tar tvf -   (.tar.gz .taz .tar.z も同じ)
#  .tar.bz2    bzip2 -dc | tar tvf -  (.tbz2 も同じ)
#  .tar.xz     xz -dc | tar tvf -     (.txz も同じ)
#  .tar.zst    zstd -dc | tar tvf -   (.tzst も同じ)
#  .lzh        lha
#  .zip        unzip -l               (.jar も同じ)
#  .rpm        rpm -qplv
#  .deb        ar tv
#  .rar        lsar -l
#  .7z         7z l
#
# 例:

#	.cbz	.zip
#	.apk	.zip
#	.cbr	.rar

FILE
# 書式: suffix  program  (option)
#
# suffix を持つ file の内容を、program を実行して平文で表示します。

	.gz	gzip	-dc
	.bz2	bzip2	-dc
	.z	gzip	-dc
	.xz	xz	-dc
	.lzma	xz	-dc
	.zst	zstd	-dc

EXEC
# 書式: suffix  program  (option)
#
# suffix を持つ file を引数にして program を起動します。
#
# macOS の注意: アプリ名だけ(例: IINA)は $PATH 上のコマンドではないので
# 起動できません。open を使います(下の .mp4 の例)。open -a の直後には
# アプリ名が要るので、`open -a ファイル` はファイルをアプリ名とみなして
# エラーになります。既定のアプリで開くなら -a を付けずに open だけです。
# info は Homebrew では texinfo に入っています(brew install texinfo)。
#
# macOS では、ここに無い suffix のファイルでも、CODE でバイナリと判定され、
# 画像・PDF か、クイックルックが扱える種類(qlmanage -m plugins の一覧。
# .numbers .key .pages .docx .xlsx、音声、動画、フォントなど)のものは、
# その旨を表示する代わりにクイックルック(qlmanage -p)で開きます。

#	.mp4	open
#	.mp4	open	-a	IINA
	.xcf	open 	-a	GIMP
	.info	info	-f
	.info.gz info	-f

EGREP
# 書式: 文字列
#
# EGREP と CUT(正規表現)の ^R の一覧の先頭に、この順で載せておく検索文字列
# (もう一度 ^R で履歴)。以前の節名 GREP も使えます。
# (空白を含む文字列は "" で囲みます。)
#
# HELP の EGREP の章の正規表現一覧と同じ順に、HELP 自身の本文に
# マッチする例を並べています。macOS(BSD grep)と Linux(GNU grep)の両方の
# grep -E で同じ意味になるように、\d/\D は [0-9]/[^0-9] で書き、grep -E に
# 無い最短一致(*?/+?)・(?:...)・先読み/後読みの例はありません。
#

	"^  [0-9]+\."            # ^     : 章の見出し(1. 2. ...)
	）$                       # $     : 全角の閉じ括弧で終わる行
	\bls\b                   # \b    : 単独の ls
	usilic\B                 # \B    : usilicrc の usilic
	m.n                      # .     : man
	\^[JOX][a-z]             # [ ]   : ^Jp ^Ou ^Xd など
	"\^[^JOX ]"              # [^ ]  : ^M ^[ ^K など
	[a-z]+\(1\)              # [a-z] : usilic(1) man(1) など
	[0-9]\.[0-9]\.           # \d    : 節番号 2.2. など
	[0-9]+[^0-9][0-9]+       # \D    : 01/66 1.5 0x20 など
	\w+rc\b                  # \w    : usilicrc
	\^\W                     # \W    : ^[ ^@
	\^J\s                    # \s    : ^J b
	~/\S+                    # \S    : ~/.usilic/history など
	-[a-z]*v[a-z]*           # *     : -rvi -vf など
	[0-9]+%                  # +     : 48% など
	\.tar(\.gz)?             # ?     : .tar .tar.gz
	[0-9]{4}                 # {n}   : 1918 2000 など
	"^[^	].*	"              # \t    : HELP の章の見出し(行頭がタブでなく、タブを含む行)
	[0-9]{2,}                # {n,}  : 2桁以上の数
	\b[a-z]{2,3}\(1\)        # {n,m} : ls(1) man(1) vi(1) など
	CP|MV|RM                 # |     : CP MV RM
	\.(gz|bz2|xz|zst)        # ( )   : 圧縮形式の suffix
	~/\.usilic/              # \.    : ~/.usilic/
	\(\?                     # \?    : (?: (?= など

PROGRAM
# 書式: program  (option)
#
# PROGRAM で起動する program の一覧。

	jed
	mg
	vi
	less
	man
	info
	top
	lv
	lv -Oe
	lv -Ir
	qlmanage -p

EDITOR
# 書式: エディター
#
# EDIT で起動するエディター。環境変数 EDITOR があればそちらを優先します。

	pico
#	vi
#	jed

BUFFER
# 書式: サイズ
#
# バッファへ読み込む最大サイズ(単位は MB、1〜100。既定は 64)。これを超える
# file は ^M 等で開くと全体を読み込まず、^O^M と同じく画面に出る分だけ
# 読み込む方法で開きます。一覧(ls、DU、LOCATE、アーカイブの内容)や
# アーカイブから取り出した file、MAN、^[^M(そのまま読む)は、ここまでで
# 読み込みを止めます。どちらの場合も「Not enough buffer」を表示します
# (どれかのキーで消えます)。usilic -b で試し、usilic -B でここへ書き込めます。

	64

CODE
# 書式: code0  code1 ...
#
# 上の suffix を持たない file に、ここに無い 0x20 未満の制御コードが含まれて
# いれば、バイナリファイルとみなして file(1) を実行し、その制御コードと
# ファイルの種類を表示します(code0 が 0 ならこの判定をしません)。
#

# ^A(TAGS)  ^G(BEL)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
   1         7        8   9  10  12  13  14      15      26       27       31

SHELL
# 書式: shell
#
# SHELL モードで起動するシェル。環境変数 SHELL が bash、zsh、tcsh、csh の
# どれかならそちらが使われ、ここの設定はそれ以外(fish 等)の時だけ使われ
# ます。ここにも設定が無ければ bash を使います。SHELL モードが対応している
# のは bash、zsh、tcsh、csh です。

	bash
#	tcsh

LINE
# 書式: 行数
#
# 履歴(FILE、DIR、MAN、LOCATE、FGREP、EGREP、SHELL のコマンド)を種類ごとに
# 残す最大の行数。これを超えると古い行から消えます(USILIC はその 3 倍)。
# 0 は無制限です(既定)。履歴はメモリの面では何年分でも問題にならない
# 規模ですが、~/.usilic/history は項目が増えるたびに全体を書き直すので、
# 保存が重く感じるようになったら上限を付けてください。usilic -l で試し、
# usilic -L でここへ書き込めます。

	0

WAIT
# 書式: wait
#
# マクロを wait(単位は 10 msec)の間隔で実行します。usilic -w で試し、
# usilic -W でここへ書き込めます。

	1

CP
# 書式: cp  (option)
#
# CP のコマンド。(既定: cp -vR)
#

#	cp -vRi

MV
# 書式: mv  (option)
#
# MV のコマンド。(既定: mv -v)
#

#	mv -vi

RM
# 書式: rm  (option)
#
# RM のコマンド。(既定: rm -vr)
#

#	rm -vri

SERIF
# 書式: フォントファイル
#
# -g で明朝体(serif)に使うフォント。EPUB の本文等、CSS で明朝体と指定された
# 字をこのフォントで描きます。上から順に試し、使える最初のものを使います。
# 無ければ組み込みの候補(ヒラギノ明朝 ProN、Noto Serif CJK 等)を使います。

#	/System/Library/Fonts/ヒラギノ明朝 ProN.ttc

SANS-SERIF
# 書式: フォントファイル
#
# -g でゴシック体(sans-serif)に使う和文のフォント。画面の全角の字(EPUB で
# ゴシック体と指定された字を含む)をこのフォントで描きます。上から順に試し、
# 使える最初のものを使います。無ければ組み込みの候補(ヒラギノ角ゴシック、
# Noto Sans CJK 等)を使います。

#	/System/Library/Fonts/ヒラギノ角ゴシック W4.ttc

SPEED
# 書式: usec1  usec2 ...  (段1〜10)
#
# 慣性スクロールの段ごとの速さ。1 行(-g では 1 ドット)進むごとに待つ時間を
# 段 1(最も遅い)から順に、単位 usec で書きます。足りない段は組み込みの値の
# ままです。usilic -s で試し、usilic -S でここへ書き込めます。

	90000 20000 10000 5000 3000 2000 1000 500 200 100

DRAG
# 書式: dot1  dot2 ...  (段1〜10)
#
# 画面をドラッグして離した時に、その直前の動きの量(ドット)がいくつ以上なら
# 段 1、段 2 ...の慣性スクロールになるか。usilic -d で試し、usilic -D でここへ
# 書き込めます。

	1 2 4 8 16 30 40 50 60 70

ARROW
# 書式: usec1  usec2 ...  (段1〜、10 個より多くてもよい)
#
# 横書きの画面で矢印キーで動かす慣性スクロールの段ごとの速さ(書式は SPEED と
# 同じ)。マウスのドラッグで始めた慣性は 2 つ速い方へずらした段(下の値なら
# 25000)から始まり、その慣性中の矢印キーでの加減速もずらしたまま。この節が
# 無ければ SPEED の値。縦書きの EPUB の左右は SPEED。

	200000 100000 25000 10000 5000 2000 1000 500 200 100 50

FONT
# 書式: フォントファイル
#
# -g の画面の基本の(半角の)等幅フォント。全角の字は SANS-SERIF、明朝体は
# SERIF のフォントで描きます。無ければ組み込みの候補を使います。usilic -f で
# 試し、usilic -F でここへ書き込めます。

#	/Library/Fonts/MS-Gothic.ttf

URL
# 書式: 名前  program  (option)
#
# EPUB の本文の Web のリンク(http 等)を [Enter]・クリックで踏んだ時の対処。
# 書いた順に ^Ow で巡回し、名前(4文字)を mode-line に表示します。最初の行が
# 既定です。名前は次のどれかです。
#   Open  program に URL を渡して起動(既定のブラウザで開く等)
#   Pdf   program(url2pdf)でページ全体を縦長の 1 ページの PDF にして
#         ~/Downloads へ保存し、クイックルックで開く(Linux は xdg-open)。
#         Playwright の準備が要ります(~/.local/lib/usilic/url2pdf の
#         コメント参照)
#   Dump  program に URL を渡した出力を usilic の画面で読む(^G で本へ戻る)
#   Term  program に URL を渡して端末で起動(EXEC と同じ、終われば本へ戻る)
#   Copy  program の標準入力へ URL を渡す(クリップボードへコピー)
#   Look  クイックルック(macOS だけ、program は不要)
# この節が無ければ下の内容(Linux は Open が xdg-open、Copy が
# xclip -selection clipboard、Look は無し。Pdf は url2pdf がある時だけ)を
# 使います。

#	Open	open
#	Pdf	~/.local/lib/usilic/url2pdf
#	Dump	w3m -dump
#	Term	w3m
#	Copy	pbcopy
#	Look

KEY
# キーの割り当て。
#
# 書式: F-n  キー    (接頭キー F-0〜F-4 の定義)
#       K-n  キー    (機能 K-n のキー)
#
# K-n の番号は機能ごとの ID で、HELP の記載順に振ってあります(KEY の一覧も
# その順)。行の順序や番号の並びに意味は無く、行を並べ替えてもキーと機能の
# 組み合わせは変わりません。キーを変えると、その機能は新しい
# キーでだけ動き、元のキーは効かなくなります(元のキーを別の機能に
# 割り当てることもできます)。キーを空にすると、その機能は割り当て無しに
# なります。行を消した番号は、既定のキーのまま(接頭キー F-n を変えていれば
# 新しい接頭キー)で動きます。
#
# キーの書き方:
#   F-n    接頭キー F-n
#   C-x    Ctrl+x(C-a〜C-z、C-[ C-\ C-] C-^ C-_、C-SPC)
#   ESC    esc      SPC  space
#   N      数字 0〜9 のいずれか(末尾のみ。^JN や ^[N のように N を使う機能だけ)
#   その他 その 1 文字(# は書けません)
#
# プロンプトの入力中、SHELL 画面、文字を入力する一覧では、F-0/F-1/F-2/F-4
# または ESC で始まるキーだけが置き換わります(1 文字のキーや ^C で始まる
# キーは、そこでは文字や入力の中断として扱われます)。同じキーを二つの機能に
# 割り当てたり、あるキーが別のキーの頭になっていたりすると、usilicrc の
# エラーとして後の方が割り当て無しになります。
#
	F-0	C-x         # ^X
	F-1	C-j         # ^J
	F-2	C-o         # ^O
	F-3	C-c         # ^C
	F-4	C-j C-o     # ^J^O

