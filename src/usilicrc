	K-7	C-f         # ^F      ページ送り
	K-8	b           # b       ページ戻し
	K-9	C-b         # ^B      ページ戻し
	K-10	ESC v       # ^[v     ページ戻し
	K-11	ESC <       # ^[<     先頭へ
