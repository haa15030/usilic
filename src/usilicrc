# tcbrc  version 1.5b-1  20 Mar 2000
# -------------------------------------------------------------
# All blank lines or strings begin with the character '#' will be ignored.
# Lines begin with one of the following strings are available.  Other lines 
# begin with any character except for '#', Space, Tab, and '\n' will cause 
# an error. 
#
# ARCHIVE, FILE, EXEC, GREP, PROGRAM, EDITOR, BUFFER, CODE, SHELL,
# HISTORY, WAIT, SCROLL, LS, CP, MV, RM, KEY, F-?, M-?, P-?, K-?
# -------------------------------------------------------------

ARCHIVE
# Format: `suffix0' `suffix1'
#
# Tcb will display the content of the file that has the `suffix0' with the
# setting of `suffix1' defined in str.c of source file.
#
#  `suffix1' `program' (option)
#  .tar	     tar       tvf",
#  .tgz	     gzip      -dc | tar tvf -",
#  .tar.bz2  bzip2     -dc | tar tvf -",
#  .lzh	     lha",
#  .zip	     unzip     -l",
#  .rpm	     rpm       -qplv",
#  .deb	     dpkg-deb  -c",
#
	.taz	.tgz
	.tar.z	.tgz
	.tar.gz	.tgz
	.jar	.zip
	
FILE
# format: `suffix' `program' (option)
#
# The `program' will display the content of the regular-file that has the 
# `suffix' as a plain text.

	.gz	gzip	-dc
	.bz2	bzip2	-dc
	.z	gzip	-dc			
#	.dvi	dvi2tty

EXEC
# format: `suffix' `program' (option)
#
# The `program' will be launched with argument of the file that has the `suffix'.

	.html	lynx
	.htm	lynx
	.info	info	-f
	.info.gz info	-f
	.dvi	xdvi			
#	.dvi	dviout			

GREP
# format: `string'
#
# The `string' that will be used in EGREP or CUT.
# (String contains a space character must be enclosed within parentheses "".)

	\/\*[a-z]*\*\/				 # tcb source
	^					 # ~/.tcb/history 
	"^  [0-9][0-9]+\."			 # ^J^B for HELP
	"^  [0-9]+\."				 # ^J^C for HELP
	^Question				 # Linux-FAQ
	"^Subject: "				 # Mailing list
	^[0-9]*\.				 # FAQ etc.
	"^[A-Z][A-Z]+"			 # MAN
	"diff \-"				 # diff file
	~$					 # backup file

PROGRAM
# Format: `program' (option)
#
# The `program' that will be launched by PROGRAM.

	jed
	emacs
	emacs -nw
	xemacs
	vi
	less
	dviout
	xdvi
	lynx
	mule
	mule -nw
	info
	top
	lv
	lv -Oe
	lv -Ir

EDITOR
# Format: `editor'
#
# The `editor' will be launched by EDIT.

	vi
#	jed

BUFFER
# Format: `size'
#
# The maximun `size' of the buffer (a unit is MB) which will be
# allocated for the regular-file or archive.

	8

CODE
# Format: `code0' `code1' ...
#
# If a regular-file that has no above suffixes contains a control
# character under 0x20 excluding the ones set in here, it will be
# assumed as a binary file.  Tcb(1) will execute file(1) and
# display the code and the file-type. (If `code0' is equal to 0,
# this setting will be ignored.)

# ^A(TAGS)  \b  \t  \n  \f  \r  ^N(SO)  ^O(SI)  ^Z(EOF)  ^[(ESC)  ^_(info)
   1         8   9  10  12  13  14      15      26       27       31

SHELL
# Format: `shell'
#
# SHELL-mode will be launched with `shell'.  (When the environment
# variable ``SHELL'' is set to neither ``bash'' nor ``tcsh'', 
# this setting (bash(1) or tcsh(1) can be set) is needed.)

	bash
#	tcsh

HISTORY
# Format: `line'
#
# It determines the maximum `line' that will be saved to the HISTORY
# list.  When the value of total-lines are equal to this line, 
# the oldest line will be deleted.

	500

WAIT
# Format: `wait' 
# 
# Built-in or keyboard macro will be executed at intervals of `wait'
# (a unit is 10 msec).

	1

LS
# Format: `flag' 
# 
# The `flag' for switching display-mode of file-selector. (can be
# switched by ^Ol.)  When the `flag' set, file-selector will display
# only filename.

	0

SCROLL
# Format: `flag' 
# 
# The `flag' for switching scroll-mode. (can be switched by ^Oh.)
# When the `flag' set, tcb window will scroll within the range above
# bottom line.

	0

CP
# Format: `cp' (option)
#
# Command of CP mode. (default : cp -vRi) 
#
#	cp -vR

MV
# Format: `mv' (option)
#
# Command of MV mode. (default : mv -vi) 
#
#	mv -v

RM
# Format: `rm' (option) 
#
# Command of RM mode. (default : rm -vri) 
#
#	rm -vr

